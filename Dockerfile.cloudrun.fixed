# Optimized Dockerfile for Google Cloud Run with explicit video copying
FROM python:3.10-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    ffmpeg \
    wget \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code (excluding large directories first)
COPY *.py ./
COPY templates/ ./templates/
COPY static/ ./static/
COPY INCLUDE/ ./INCLUDE/

# Explicitly copy knowledge_base with videos
COPY knowledge_base/ ./knowledge_base/

# Create necessary directories for runtime
RUN mkdir -p uploads temp_audio

# Verify videos are present (this will fail the build if videos are missing)
RUN test -d knowledge_base/videos && \
    echo "Videos directory found: $(ls -1 knowledge_base/videos/ | wc -l) files" || \
    (echo "ERROR: Videos directory not found!" && exit 1)

# Set environment variables for Cloud Run
ENV PORT=8080
ENV PYTHONUNBUFFERED=1
ENV FLASK_ENV=production

# Cloud Run expects the app to listen on $PORT
EXPOSE 8080

# Use gunicorn for production
CMD exec gunicorn --bind :$PORT --workers 1 --threads 8 --timeout 0 unified_app:app
