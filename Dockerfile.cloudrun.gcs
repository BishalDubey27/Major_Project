# Optimized Dockerfile for Google Cloud Run with GCS for videos
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    ffmpeg \
    wget \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY *.py ./
COPY templates/ ./templates/
COPY static/ ./static/
COPY INCLUDE/ ./INCLUDE/

# Copy only metadata (not videos - they're in GCS)
COPY knowledge_base/metadata.json ./knowledge_base/metadata.json
COPY knowledge_base/*.json ./knowledge_base/ 2>/dev/null || true
COPY knowledge_base/*.faiss ./knowledge_base/ 2>/dev/null || true

# Create runtime directories
RUN mkdir -p uploads temp_audio knowledge_base/videos knowledge_base/generated_audio

# Set environment variables
ENV PORT=8080
ENV PYTHONUNBUFFERED=1
ENV FLASK_ENV=production
ENV USE_GCS=true
ENV GCS_BUCKET=isl-translator-492416-videos

EXPOSE 8080

CMD exec gunicorn --bind :$PORT --workers 1 --threads 8 --timeout 0 unified_app:app
