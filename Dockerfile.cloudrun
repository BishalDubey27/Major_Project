# Use Python 3.10 slim image
FROM python:3.10-slim

# Set working directory
WORKDIR /app

# Install system dependencies for OpenCV and MediaPipe
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender1 \
    libgomp1 \
    ffmpeg \
    wget \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Make startup script executable
RUN chmod +x startup.sh

# Verify critical files exist
RUN test -f knowledge_base/metadata.json || (echo "ERROR: metadata.json missing!" && exit 1)
RUN test -d knowledge_base/videos || (echo "ERROR: videos directory missing!" && exit 1)

# Create necessary directories
RUN mkdir -p uploads temp_audio knowledge_base/generated_audio

# Generate FAISS index for semantic search (CRITICAL for /search endpoint)
RUN python setup_database.py && \
    test -f video_index.faiss || (echo "ERROR: FAISS index generation failed!" && exit 1)

# Generate audio files for all videos at build time (optional but recommended)
RUN python generate_audio_for_new_videos.py || echo "Warning: Could not pre-generate audio files"

# Set environment variables
ENV PORT=8080
ENV PYTHONUNBUFFERED=1

# Expose port
EXPOSE 8080

# Run the application with startup script
CMD ["./startup.sh"]
